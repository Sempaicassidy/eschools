APP_NAME="E-Schools Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.eschools.co.tz

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database Configuration (MySQL / PostgreSQL for Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eschools_prod
DB_USERNAME=eschools_user
DB_PASSWORD=SecurePasswordHere123!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.eschools.co.tz

SANCTUM_STATEFUL_DOMAINS=app.eschools.co.tz,eschools.co.tz

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@eschools.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# SMS Gateway (Beem SMS / Africa's Talking)
SMS_GATEWAY=beem
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=INFO
